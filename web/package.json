{
  "name": "@otter/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --configLoader native",
    "build": "tsc -b && vite build --configLoader native",
    "preview": "vite preview --host 0.0.0.0 --configLoader native",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --passWithNoTests --configLoader native"
    ,"test:e2e": "playwright test"
  },
  "dependencies": {
    "@otter/shared": "0.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
