{
  "name": "@otter/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:lab": "tsx watch src/lab-server.ts",
    "dev:demo": "tsx watch src/demo-server.ts",
    "start:lab": "node dist/lab-server.js",
    "start:demo": "node dist/demo-server.js",
    "preflight:external-preview": "node dist/scripts/external-preview-preflight.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:acceptance": "vitest run tests/acceptance",
    "test:experience": "vitest run tests/unit/experience-constitution.test.ts tests/unit/policy-router.test.ts tests/unit/reply-validator.test.ts tests/acceptance/character-freeze.acceptance.test.ts tests/acceptance/response-language.acceptance.test.ts",
    "pretest:eval:core": "npm run build",
    "test:eval:core": "node dist/scripts/core-dialogue-eval.js --lane=deterministic",
    "pretest:eval:core:model": "npm run build",
    "test:eval:core:model": "node dist/scripts/core-dialogue-eval.js --lane=model",
    "pretest:eval:skill:astrology": "npm run build",
    "test:eval:skill:astrology": "node dist/scripts/astrology-skill-eval.js --lane=deterministic",
    "pretest:eval:skill:astrology:model": "npm run build",
    "test:eval:skill:astrology:model": "node dist/scripts/astrology-skill-eval.js --lane=model",
    "prereview:skill:astrology": "npm run build",
    "review:skill:astrology": "node dist/scripts/astrology-skill-blind-review.js",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/scripts/seed.ts",
    "invites": "tsx src/scripts/generate-invites.ts",
    "cleanup": "tsx src/scripts/cleanup.ts",
    "export:research": "tsx src/scripts/export-research.ts",
    "prereport:events": "npm run build",
    "report:events": "node dist/scripts/core-dialogue-event-audit.js",
    "prereport:product-metrics": "npm run build",
    "report:product-metrics": "node dist/scripts/core-dialogue-product-metrics.js",
    "prereport:feedback-gate": "npm run build",
    "report:feedback-gate": "node dist/scripts/voluntary-feedback-gate.js",
    "prereport:ai-privacy": "npm run build",
    "report:ai-privacy": "node dist/scripts/ai-telemetry-privacy-audit.js",
    "review:experience": "node dist/scripts/core-experience-blind-review.js",
    "prereport:release": "npm run build",
    "report:release": "node dist/scripts/core-dialogue-release-decision.js",
    "prepreflight": "npm run build",
    "preflight": "node dist/scripts/preflight.js",
    "preinit:full": "npm run build",
    "init:full": "node dist/scripts/init-full.js",
    "prereport:acceptance": "npm run build",
    "report:acceptance": "node dist/scripts/acceptance-report.js",
    "pretest:model": "npm run build",
    "test:model": "node dist/scripts/model-acceptance.js",
    "test:model:low-signal": "node dist/scripts/model-acceptance.js --suite=low-signal",
    "test:model:expression": "node dist/scripts/model-acceptance.js --suite=expression",
    "test:emotion": "node dist/scripts/emotion-evaluation.js --validate-only",
    "test:model:emotion": "node dist/scripts/emotion-evaluation.js --model",
    "report:emotion": "node dist/scripts/emotion-evaluation.js && node dist/scripts/emotion-expression-report.js",
    "test:memory": "node dist/scripts/memory-evaluation.js",
    "test:model:memory": "node dist/scripts/memory-evaluation.js --model",
    "test:healing": "vitest run tests/unit/healing-engine.test.ts tests/unit/healing-routes.test.ts",
    "pretest:eval:healing": "npm run build",
    "test:eval:healing": "node dist/scripts/healing-eval.js",
    "prereview:healing": "npm run build",
    "review:healing": "node dist/scripts/healing-blind-review.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@langfuse/otel": "^5.10.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@otter/shared": "0.1.0",
    "@prisma/client": "^6.14.0",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0",
    "openai": "^5.16.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prisma": "^6.14.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
