# Copy to .env.local. Never commit real secrets.
DATABASE_URL="postgresql://otter:otter@localhost:5432/spirit_otter?schema=public"
SESSION_SECRET="replace-with-at-least-32-random-characters"
LLM_PROVIDER="deepseek"
LLM_BASE_URL="https://api.deepseek.com"
LLM_API_KEY=""
LLM_MODEL="deepseek-v4-flash"
LLM_JSON_MODE="true"
LLM_TIMEOUT_MS="15000"
SERVER_HOST="0.0.0.0"
SERVER_PORT="3001"
WEB_ORIGIN="https://otter.local"
COOKIE_SECURE="true"
RESEARCH_CONTACT="请联系现场研究人员"
LOCAL_TEST_MODE="false"
OTTER_RUNTIME_MODE="full"
EXPRESSION_STYLE_V2="false"
EMOTION_INFERENCE_V2="false"
SCENE_WORLD_V1="false"
AUDIO_V1="false"
MEMORY_V2="false"
ASTROLOGY_SKILL_V1="false"
# Only for the temporary HTTPS preview launcher. Keep disabled in normal full/demo runs.
EXTERNAL_PREVIEW_ENABLED="false"
EXTERNAL_PREVIEW_CODE=""
EXTERNAL_PREVIEW_MAX_SESSIONS="20"
APP_TIME_ZONE="Asia/Shanghai"
# Optional cloud voice pack. AZURE_SPEECH_VOICE remains the legacy 鹿禅 override.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
AZURE_SPEECH_VOICE="zh-CN-YunjianNeural"
AZURE_SPEECH_VOICE_LUCHAN="zh-CN-YunjianNeural"
AZURE_SPEECH_VOICE_TATA="zh-CN-XiaoxiaoNeural"
AZURE_SPEECH_VOICE_FEIER="zh-CN-XiaoyiNeural"
BUILD_VERSION="auto"
