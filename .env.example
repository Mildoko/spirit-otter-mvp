# Copy to .env.local. Never commit real secrets.
DATABASE_URL="postgresql://otter:otter@localhost:5432/spirit_otter?schema=public"
SESSION_SECRET="replace-with-at-least-32-random-characters"
LLM_PROVIDER="deepseek"
LLM_BASE_URL="https://api.deepseek.com"
LLM_API_KEY=""
LLM_MODEL="deepseek-v4-flash"
LLM_JSON_MODE="true"
LLM_TIMEOUT_MS="15000"
SERVER_HOST="0.0.0.0"
SERVER_PORT="3001"
WEB_ORIGIN="https://otter.local"
COOKIE_SECURE="true"
RESEARCH_CONTACT="请联系现场研究人员"
LOCAL_TEST_MODE="false"
OTTER_RUNTIME_MODE="full"
BUILD_VERSION="auto"
